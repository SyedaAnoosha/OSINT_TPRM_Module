# Copy to .env and fill in. Never commit .env. DATABASE_URL is REQUIRED (Postgres only, no
# local-file fallback); everything else is optional (anonymous source tiers, default UA).

# Politeness identity. Several sources (Wikidata, HIBP) ask for a descriptive,
# contact-bearing User-Agent; Wikimedia 403s a generic/library UA. The default below
# already satisfies them — set your own contact for a real deployment.
TPRM_CONTACT_EMAIL=REPLACE_ME@example.com
TPRM_USER_AGENT=WahidAI-TPRM-PoC REPLACE_ME@example.com

# Optional free API keys (raise rate limits; collectors work without them).
# NVD: https://nvd.nist.gov/developers/request-an-api-key
TPRM_NVD_API_KEY=
# ITA / trade.gov: https://developer.trade.gov
TPRM_ITA_API_KEY=
# Cert Spotter (CT fallback for Digital Footprint). The anonymous tier is rate-limited
# hard; a free key lifts the ceiling. https://sslmate.com/certspotter/
TPRM_CERTSPOTTER_TOKEN=
# ABN Lookup (AU registry). Free GUID: abr.business.gov.au/Tools/WebServices
TPRM_ABN_GUID=
# AlienVault OTX passive DNS — CT redundancy for Digital Footprint. Free key: otx.alienvault.com
TPRM_OTX_API_KEY=
# Companies House (UK registry). Free key: developer.company-information.service.gov.uk
TPRM_COMPANIES_HOUSE_KEY=
# People Data Labs Free Company Dataset — OFFLINE firmographics fallback (industry/size/country for
# vendors nobody else classifies). OPT-IN: download the dump, then build a local index once with
#   python -m app.pdl_index build --csv <dump.csv>
# Absent index -> the collector skips (lowers coverage, never posture). Point this at the built
# index; the default is backend/data/pdl.sqlite. CONFIRM THE DATASET LICENCE (commercial use,
# redistribution, retention) before shipping — this ships no data.
TPRM_PDL_INDEX_PATH=

# Persistence — REQUIRED. The store is Postgres only: a defensible, reconstructible evidence
# trail is the product (Finding A), and there is no local-file fallback with weaker guarantees.
# Use a Neon connection string (or any Postgres). Without it the app fails loudly at startup.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Paths (defaults resolve relative to the repo root; override if needed).
# TPRM_SCORING_YAML_PATH=../scoring.yaml
# TPRM_DATA_DIR=./data          # cache files only (e.g. the ITA CSL download), never the score record

# Optional LLM evidence-summariser (read layer only — it NEVER affects the score and NEVER
# writes to the immutable evidence store). Provider-agnostic: any OpenAI-compatible
# chat/completions endpoint works. Leave unset and the /summary endpoint returns 503.
# Pick ONE provider:
#   OpenRouter — https://openrouter.ai/keys
#     TPRM_LLM_BASE_URL=https://openrouter.ai/api/v1
#     TPRM_LLM_MODEL=google/gemini-2.0-flash-001   (or any :free model)
#   Groq — https://console.groq.com/keys
#     TPRM_LLM_BASE_URL=https://api.groq.com/openai/v1
#     TPRM_LLM_MODEL=llama-3.3-70b-versatile
#   Google Gemini (OpenAI-compat) — https://aistudio.google.com/apikey
#     TPRM_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     TPRM_LLM_MODEL=gemini-2.0-flash
TPRM_LLM_BASE_URL=
TPRM_LLM_API_KEY=
TPRM_LLM_MODEL=
# TPRM_LLM_REFERER=https://your-app.example   # OpenRouter attribution (optional)

# E14 gap analysis & recommendations — a SEPARATE, three-provider chain from the summariser above
# (app/gap_analysis.py). Also a read layer: it never affects the score and never writes to the
# evidence store. Fixed fallback order Gemini -> Groq -> OpenRouter; each is tried once, and the
# chain falls back only on a transport failure or rate limit, never on the content of a reply.
# Leave all three unset and POST /api/vendors/{ref}/gap-analysis returns 503.
#
# EACH PROVIDER MUST BE SET AS A COMPLETE TRIO OR LEFT COMPLETELY EMPTY — a partially-filled
# provider (e.g. a base_url with no key) fails app startup rather than silently promoting the next
# provider to primary. Any subset of the three below may be configured; at least one is required
# to enable the feature.
#   Google Gemini (OpenAI-compat) — https://aistudio.google.com/apikey — primary, cheapest per
#   token at this context size, long context window
TPRM_GEMINI_BASE_URL=
TPRM_GEMINI_API_KEY=
TPRM_GEMINI_MODEL=
#   Groq — https://console.groq.com/keys — secondary, a different vendor with a different failure
#   surface (fast open-weight inference, not to be confused with xAI's "Grok" model)
TPRM_GROQ_BASE_URL=
TPRM_GROQ_API_KEY=
TPRM_GROQ_MODEL=
#   OpenRouter — https://openrouter.ai/keys — tertiary; a router, so it is a fallback for the
#   fallback's outage too
TPRM_OPENROUTER_BASE_URL=
TPRM_OPENROUTER_API_KEY=
TPRM_OPENROUTER_MODEL=
# TPRM_GAP_ANALYSIS_TIMEOUT_S=45

TPRM_LOG_LEVEL=INFO
TPRM_HTTP_TIMEOUT_S=15
